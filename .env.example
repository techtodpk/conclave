# Copy this file to .env and add your key. The .env file is ignored by Git.
#
# Conclave looks for the key in this order:
#   1. the OPENROUTER_API_KEY environment variable
#   2. a .env file in the folder you run conclave from
#   3. a .env file beside your config file (~/.conclave/.env)
#
# Get a key at https://openrouter.ai/keys. Credits are prepaid; leave auto top-up off
# if you want a hard ceiling on spending.
OPENROUTER_API_KEY=
